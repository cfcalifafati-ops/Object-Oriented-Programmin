# Detailed Design Pseudocode

```text
CLASS User
    PROTECTED user_id : STRING
    PUBLIC name : STRING

    CONSTRUCTOR(user_id: STRING, name: STRING)
        SET self.user_id = user_id
        SET self.name = name
    END CONSTRUCTOR

    METHOD get_details() -> STRING
        RETURN "ID: " + self.user_id + " | Name: " + self.name
    END METHOD
END CLASS

CLASS Member INHERITS User
    PRIVATE borrowed_books : LIST OF STRING

    CONSTRUCTOR(user_id: STRING, name: STRING)
        CALL SUPER(user_id, name)
        SET self.borrowed_books = NEW LIST
    END CONSTRUCTOR

    METHOD borrow_book(book_title: STRING) -> STRING
        IF LENGTH(self.borrowed_books) >= 5 THEN
            RETURN "Error: Borrowing limit reached (Max 5 books)."
        END IF
        APPEND book_title TO self.borrowed_books
        RETURN "Success: Borrowed '" + book_title + "'."
    END METHOD

    OVERRIDE METHOD get_details() -> STRING
        RETURN "[Member] ID: " + self.user_id + " | Name: " + self.name + " | Borrowed: " + LENGTH(self.borrowed_books) + "/5"
    END METHOD
END CLASS

CLASS Librarian INHERITS User
    PRIVATE employee_id : STRING

    CONSTRUCTOR(user_id: STRING, name: STRING, employee_id: STRING)
        CALL SUPER(user_id, name)
        SET self.employee_id = employee_id
    END CONSTRUCTOR

    OVERRIDE METHOD get_details() -> STRING
        RETURN "[Librarian] ID: " + self.user_id + " | Name: " + self.name + " | Staff ID: " + self.employee_id
    END METHOD
END CLASS
